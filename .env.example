# Copy to .env and fill in.
# Free HuggingFace token (needed once to download the pyannote diarization model).
# Get it at https://huggingface.co/settings/tokens  (read scope is enough)
# Then accept the model license (once, logged in):
#   https://huggingface.co/pyannote/speaker-diarization-community-1
HF_TOKEN=

# Ollama model for summary + analytics
OLLAMA_MODEL=qwen2.5:7b

# Whisper model size: tiny | base | small | medium | large-v3
WHISPER_MODEL=large-v3

# ASR backend: mlx (Apple GPU) | cuda (NVIDIA GPU) | faster (CPU). Default mlx.
ASR_BACKEND=mlx
# CTranslate2 compute type override for cuda/faster (blank = float16 on cuda, int8 on cpu).
# WHISPER_COMPUTE_TYPE=float16

# Public API key for third parties (X-API-Key header). Additional keys can be
# created/revoked at runtime in the admin portal (/admin).
API_KEY=change-me

# Admin portal (/admin) password — seeded on first run into the DB (hashed).
# Change it later from the portal; this env value only bootstraps it.
ADMIN_PASSWORD=change-me-admin
