# Copy to `.env` and fill in. DATABASE_URL / OLLAMA_HOST / ASR_BACKEND are set by
# docker-compose (to the sibling services) — do NOT set them here.

# --- Secrets / models ---
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxx        # HuggingFace token (pyannote diarization)
WHISPER_MODEL=large-v3-turbo
SPEAKER_MODE=hybrid                          # hybrid = acoustic clusters + LLM role naming (recommended)
SPEAKER_PAUSE_GAP=0.6
AUDIO_CLEANUP=true
OLLAMA_MODEL=qwen2.5:7b

# --- Throughput ---
WORKER_CONCURRENCY=2                         # raise only if the box has RAM/VRAM headroom

# --- Public API auth (per-environment keys are created/managed in the admin UI) ---
API_KEY=asr_change_me_bootstrap_key          # bootstrap key; issue per-env keys in Admin → API Keys

# --- Admin portal (first admin seeded on first boot; add more in Admin → Admins) ---
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change-this-strong-password

# --- Global webhook fallback (per-key webhooks in the admin override this) ---
WEBHOOK_ENABLED=false
WEBHOOK_URL=
WEBHOOK_SECRET=

# --- Optional: bundled cloudflared tunnel (only if you run `--profile tunnel`) ---
CLOUDFLARE_TUNNEL_TOKEN=
